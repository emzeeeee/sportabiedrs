# Server-only secrets. Set them in Vercel: Project > Settings > Environment Variables. Never commit real values.

# Shop checkout: api/create-checkout-session.js (Stripe Checkout). Without it the shop offers cash on delivery.
STRIPE_SECRET_KEY=
# Public URL for Stripe success/cancel redirects. Falls back to the request host when empty.
SITE_URL=https://sportabiedrs.lv

# Contact form + newsletter: api/contact.js (Resend). Without it the forms fall back to the visitor's mail app.
RESEND_API_KEY=
CONTACT_TO=info@sportabiedrs.lv
EMAIL_FROM=SportaBiedrs <noreply@sportabiedrs.lv>

# Reserved for the booking backend and AI chat (not used by this repo yet)
CLERK_SECRET_KEY=
OPENAI_API_KEY=

# Public browser configuration (publishable by design)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
