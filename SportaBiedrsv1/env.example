# Server-only secrets. Set them in Vercel: Project > Settings > Environment Variables.
# For local testing copy this file to .env (it is git-ignored). Never commit real values.

# --- Shop checkout (api/create-checkout-session.js, api/stripe-webhook.js) ---
# Use sk_test_... while testing, sk_live_... only when you really sell.
STRIPE_SECRET_KEY=
# Stripe Dashboard > Developers > Webhooks > add https://YOUR-SITE/api/stripe-webhook, event checkout.session.completed
STRIPE_WEBHOOK_SECRET=
# Public URL used for Stripe redirects, e.g. https://sportabiedrs.lv (falls back to the request host)
SITE_URL=

# --- Email: contact form, newsletter, cash orders, paid-order alerts (Resend) ---
RESEND_API_KEY=
# A sender on a domain verified in Resend, e.g. "SportaBiedrs <shop@sportabiedrs.lv>"
EMAIL_FROM=
# Where order and contact emails go (your inbox)
CONTACT_TO=
# Optional: also store newsletter signups in this Resend audience
RESEND_AUDIENCE_ID=

# --- AI chat (api/ai-chat.js); without a key the site uses its built-in scripted replies ---
OPENAI_API_KEY=
# Optional: any OpenAI-compatible provider and model
OPENAI_BASE_URL=
OPENAI_MODEL=

# --- Reserved for the booking backend (not built yet) ---
CLERK_SECRET_KEY=

# --- Public browser configuration (publishable by design, also set in index.html) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
